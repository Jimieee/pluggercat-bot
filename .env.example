APP_NAME=pluggercat
LOG_LEVEL=info
VOICE_QUEUE_IDLE_DISCONNECT_AFTER=3m
VOICE_ALONE_DISCONNECT_AFTER=3m

DISCORD_TOKEN=token
DISCORD_DEV_GUILD_ID=

LAVALINK_NODE_NAME=main
LAVALINK_ADDRESS=localhost:2333
LAVALINK_PASSWORD=pass
LAVALINK_SECURE=false
LAVALINK_YOUTUBE_PLAYLIST_LOAD_LIMIT=100

# Recommended YouTube backend for VPS/datacenter deployments.
# Valid values: "ytdlp" or "youtube-source"
YOUTUBE_BACKEND=ytdlp

# youtube-source is optional now.
YOUTUBE_SOURCE_ENABLED=false

# youtube-source anti-bot options.
# Only relevant when YOUTUBE_SOURCE_ENABLED=true.
YOUTUBE_POT_TOKEN=
YOUTUBE_VISITOR_DATA=

# Optional OAuth fallback for youtube-source.
# Use a burner account only if you decide to enable this.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INITIALIZATION=false

# Remote cipher server for youtube-source.
# Only relevant when YOUTUBE_SOURCE_ENABLED=true.
YOUTUBE_REMOTE_CIPHER_URL=http://yt-cipher:8001
YOUTUBE_REMOTE_CIPHER_PASSWORD=pluggercat-yt-cipher
YOUTUBE_REMOTE_CIPHER_USER_AGENT=pluggercat

# LavaSrc source toggles.
LAVASRC_ENABLE_SPOTIFY=false
LAVASRC_ENABLE_APPLE_MUSIC=false
LAVASRC_ENABLE_DEEZER=false
LAVASRC_ENABLE_YTDLP=true

# yt-dlp direct playback for YouTube URLs, playlists and search.
LAVASRC_YTDLP_VERSION=2026.03.17
LAVASRC_YTDLP_PATH=/usr/local/bin/yt-dlp
LAVASRC_YTDLP_SEARCH_LIMIT=10
LAVASRC_YTDLP_MIX_PLAYLIST_LOAD_LIMIT=25
LAVASRC_YTDLP_PLAYLIST_LOAD_LIMIT=1000

# Spotify support.
# Required for Spotify search and recommended for Spotify track/album/playlist links.
LAVASRC_SPOTIFY_CLIENT_ID=
LAVASRC_SPOTIFY_CLIENT_SECRET=
LAVASRC_SPOTIFY_COUNTRY_CODE=US
LAVASRC_SPOTIFY_PLAYLIST_PAGE_LIMIT=6
LAVASRC_SPOTIFY_ALBUM_PAGE_LIMIT=6
LAVASRC_SPOTIFY_PREFER_ANONYMOUS_TOKEN=false
# Optional. Needed for some Spotify-generated playlists if you decide to use anonymous tokens.
LAVASRC_SPOTIFY_CUSTOM_TOKEN_ENDPOINT=

# Apple Music support.
LAVASRC_APPLE_MUSIC_COUNTRY_CODE=US
LAVASRC_APPLE_MUSIC_MEDIA_API_TOKEN=
LAVASRC_APPLE_MUSIC_PLAYLIST_PAGE_LIMIT=6
LAVASRC_APPLE_MUSIC_ALBUM_PAGE_LIMIT=6

# Deezer support.
# Deezer direct playback requires both values below.
LAVASRC_DEEZER_MASTER_DECRYPTION_KEY=
LAVASRC_DEEZER_ARL=
